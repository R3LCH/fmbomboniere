# Copy to .env on the VPS (never commit .env).
# Admin password, at least 10 characters.
ADMIN_PASSWORD=change-me-please
# Keeps admin sessions valid across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Public URL with trailing slash, used at build time for canonical/OG/sitemap.
VITE_SITE_URL=https://example.com/
